{
  "default_agent": "build",
  "agents": {
    "build": {
      "steps": 60
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": 65536
  },
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:*Start-Process*Verb*RunAs*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:* -Verb RunAs*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:runas *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:sudo *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:gsudo *",
      "effect": "deny"
    }
  ],
  "instructions": [
    "~/.config/opencode/KOREAN_INSTRUCTIONS.md"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
